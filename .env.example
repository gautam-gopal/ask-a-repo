# Optional: development (default) | production | test
NODE_ENV=
# Optional: defaults to 3000
PORT=
# Required: Atlas connection string, must include the database name /askarepo
MONGODB_URI=
# Required: at least 32 random characters
JWT_SECRET=
# Required: GitHub fine-grained personal access token, public repositories read-only, no extra permissions
GITHUB_TOKEN=
# Required: Cloudflare account id (dashboard sidebar or URL)
CLOUDFLARE_ACCOUNT_ID=
# Required: Cloudflare API token with Workers AI permission
CLOUDFLARE_API_TOKEN=
# Optional: defaults to @cf/baai/bge-base-en-v1.5
EMBEDDING_MODEL=
# Optional: defaults to 768. Must match the model and the Atlas vector index
EMBEDDING_DIMENSIONS=
# Optional: true | false (default false). Adds the BGE search-query instruction prefix
QUERY_PREFIX_ENABLED=