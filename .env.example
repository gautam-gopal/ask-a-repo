# Optional: development (default) | production | test
NODE_ENV=
# Optional: defaults to 3000
PORT=
# Required: Atlas connection string, must include the database name /askarepo
MONGODB_URI=
# Required: at least 32 random characters
JWT_SECRET=
# Required: GitHub fine-grained personal access token, public repositories read-only, no extra permissions
GITHUB_TOKEN=
# Required: Cloudflare account id (dashboard sidebar or URL)
CLOUDFLARE_ACCOUNT_ID=
# Required: Cloudflare API token with Workers AI permission
CLOUDFLARE_API_TOKEN=
# Optional: defaults to @cf/baai/bge-base-en-v1.5
EMBEDDING_MODEL=
# Optional: defaults to 768. Must match the model and the Atlas vector index
EMBEDDING_DIMENSIONS=
# Optional: true | false (default false). Adds the BGE search-query instruction prefix
QUERY_PREFIX_ENABLED=
# Required: Groq API key (console.groq.com)
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=
# Optional: defaults to openai/gpt-oss-20b. Used once on 429 or unavailable model
GROQ_FALLBACK_MODEL=
# Optional: true | false (default true). Skip test and spec files when indexing a repository (D-087)
INDEX_EXCLUDE_TESTS=
# Optional: 0 to 1, default 0.795 (provisional, D-089, see server/eval/threshold-sweep.js). Best retrieval score below this skips the LLM
SEARCH_MIN_SCORE=
# Optional (12A): proxy hops in front of the app. 1 on Render; verify with the RateLimit-Remaining check (D-091)
TRUST_PROXY=
# Optional: max accounts (default 200), then signup returns 503 SIGNUPS_CLOSED
MAX_USERS=
# Optional: estimated Cloudflare neurons per UTC day (default 8000)
DAILY_NEURON_BUDGET=
# Optional: Groq requests per UTC day across both models (default 500). Set from your Groq dashboard
DAILY_LLM_REQUEST_BUDGET=
# Optional: rate limit overrides (defaults: 5 / 10 / 20 / 60 / 5 / 10 / 300, see D-092)
RL_SIGNUP_MAX=
RL_LOGIN_MAX=
RL_ASK_USER_MAX=
RL_ASK_IP_MAX=
RL_INGEST_USER_MAX=
RL_INGEST_IP_MAX=
RL_GENERAL_MAX=